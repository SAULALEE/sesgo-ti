---
import '../styles/components/contact-form.css';
import { LIMITS } from '../lib/contact';
import { useTranslations, type Locale } from '../i18n/ui';
import { landing } from '../i18n/landing';
import { site } from '../lib/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { cursor } = landing[lang];
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const responseTime = site.responseTime[lang];
const reply = responseTime
  ? t('contact.replyIn').replace('{time}', responseTime)
  : t('contact.reply');
const footnote = [
  responseTime && t('contact.responseTime').replace('{time}', responseTime),
  t('contact.privacy'),
]
  .filter(Boolean)
  .join(' ');
const info = [
  { label: t('contact.info.email'), value: site.email },
  { label: t('contact.info.whatsapp'), value: site.whatsapp },
  {
    label: t('contact.info.city'),
    value: site.city && `${site.city}, ${t('contact.info.country')}`,
  },
].filter((row) => row.value);
---

<div id="contacto" class="anchor"></div>
<section class="contact sheet" data-sheet data-tone="light" aria-labelledby="contact-title">
  <div class="sheet__veil" aria-hidden="true"></div>
  <h2 class="contact__title" id="contact-title" data-reveal>
    {t('contact.titleStart')}<span>{t('contact.titleEnd')}</span>
  </h2>
  <div class="contact__body">
    <div class="contact__intro">
      <p class="contact__lead">{t('contact.lead')}</p>
      {
        info.length > 0 && (
          <div class="contact__info">
            {info.map((row) => (
              <>
                <span class="contact__info-label">{row.label}</span>
                <span>{row.value}</span>
              </>
            ))}
          </div>
        )
      }
    </div>
    <div class="contact__card" data-tone="dark">
      <form
        class="contact__form"
        method="post"
        action="/api/contact"
        data-sending={t('contact.sending')}
        data-error-invalid={t('contact.error.invalid')}
        data-error-captcha={t('contact.error.captcha')}
        data-error-unavailable={t('contact.error.unavailable')}
      >
        <input type="hidden" name="locale" value={lang} />

        <label class="contact__field">
          <span>{t('contact.name')}</span>
          <input class="contact__control" type="text" name="name" required maxlength={LIMITS.name} autocomplete="name" />
        </label>

        <label class="contact__field">
          <span>{t('contact.email')}</span>
          <input
            class="contact__control"
            type="email"
            name="email"
            required
            maxlength={LIMITS.email}
            autocomplete="email"
          />
        </label>

        <label class="contact__field">
          <span>{t('contact.message')}</span>
          <textarea
            class="contact__control"
            name="message"
            required
            rows="4"
            minlength={LIMITS.messageMin}
            maxlength={LIMITS.message}
            placeholder={t('contact.messagePlaceholder')}></textarea>
        </label>

        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" />}

        <p class="contact__status" role="status" aria-live="polite"></p>
        <button class="contact__submit" type="submit" data-magnetic data-cursor-label={cursor.send}>
          <span>{t('contact.submit')}</span><span aria-hidden="true">→</span>
        </button>
        <p class="contact__footnote">{footnote}</p>
      </form>

      <div
        class="contact__done"
        role="status"
        data-done
        data-thanks={t('contact.thanks')}
        data-thanks-name={t('contact.thanksName')}
        data-reply={reply}
        hidden
      >
        <p class="contact__thanks" data-done-thanks></p>
        <div class="contact__next">
          <p class="contact__reply" data-done-reply></p>
          <button class="contact__again" type="button" data-again data-cursor-label={cursor.other}>
            {t('contact.again')}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{
  siteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import { reduced } from '../scripts/motion';

  const form = document.querySelector<HTMLFormElement>('.contact__form');
  const status = form?.querySelector<HTMLElement>('.contact__status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const done = document.querySelector<HTMLElement>('[data-done]');
  const thanks = done?.querySelector<HTMLElement>('[data-done-thanks]');
  const reply = done?.querySelector<HTMLElement>('[data-done-reply]');
  let exit: Animation | undefined;

  async function showDone(name: string, email: string) {
    if (!form || !done || !thanks || !reply) return;
    if (!reduced) {
      exit = form.animate(
        [
          { transform: 'none', opacity: 1, filter: 'blur(0px)' },
          { transform: 'translate3d(0,-50px,0) skewY(-3deg)', opacity: 0, filter: 'blur(8px)' },
        ],
        { duration: 420, easing: 'cubic-bezier(.7,0,.84,0)', fill: 'forwards' },
      );
      await exit.finished;
    }
    thanks.textContent = name
      ? (done.dataset.thanksName ?? '').replace('{name}', name)
      : (done.dataset.thanks ?? '');
    reply.textContent = (done.dataset.reply ?? '').replace('{email}', email);
    form.hidden = true;
    done.hidden = false;
  }

  function showForm() {
    if (!form || !done) return;
    exit?.cancel();
    form.hidden = false;
    done.hidden = true;
  }

  done?.querySelector('[data-again]')?.addEventListener('click', showForm);

  // Case and service links prefill the message (scripts/prefill.ts).
  window.addEventListener('contact:prefill', (event) => {
    const field = form?.elements.namedItem('message');
    if (!(field instanceof HTMLTextAreaElement)) return;
    showForm();
    field.value = (event as CustomEvent<string>).detail;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !button) return;

    button.disabled = true;
    status.textContent = form.dataset.sending ?? '';

    let message = form.dataset.errorUnavailable ?? '';
    try {
      const data = new FormData(form);
      const res = await fetch(form.action, { method: 'POST', body: data });
      const result = (await res.json()) as { ok: boolean; error?: string };
      if (result.ok) {
        message = '';
        await showDone(String(data.get('name')).trim(), String(data.get('email')).trim());
        form.reset();
      } else if (result.error === 'invalid') {
        message = form.dataset.errorInvalid ?? '';
      } else if (result.error === 'captcha') {
        message = form.dataset.errorCaptcha ?? '';
      }
    } catch {
      // network failure keeps the "unavailable" message
    }

    status.textContent = message;
    button.disabled = false;
    // A Turnstile token is single-use, so request a fresh one after every attempt.
    try {
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    } catch {
      // widget not loaded
    }
  });
</script>
