---
import Layout from '../layouts/Layout.astro';
import Cases from './Cases.astro';
import ContactForm from './ContactForm.astro';
import Cursor from './Cursor.astro';
import Hero from './Hero.astro';
import Problems from './Problems.astro';
import Process from './Process.astro';
import Services from './Services.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Layout>
  <Cursor />
  <SiteHeader lang={lang} />
  <main>
    <Hero lang={lang} />
    <Problems lang={lang} />
    <Cases lang={lang} />
    <Services lang={lang} />
    <Process lang={lang} />
    <ContactForm lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</Layout>

<script>
  import '../scripts/motion';
  import '../scripts/prefill';
</script>
