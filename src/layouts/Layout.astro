---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { defaultLocale, locales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const lang: Locale = locales.find((l) => l === Astro.currentLocale) ?? defaultLocale;
const t = useTranslations(lang);
const { title = 'SESGO TI', description = t('site.description') } = Astro.props;

const otherLocale: Locale = lang === 'es' ? 'en' : 'es';
const pathname = Astro.url.pathname;
const pathInLocale =
  lang === defaultLocale ? pathname : pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const switchHref = getRelativeLocaleUrl(otherLocale, pathInLocale);
const homeHref = getRelativeLocaleUrl(lang, '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <Font cssVariable="--font-instrument-serif" />
    <Font cssVariable="--font-inter" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="wordmark" href={homeHref}>SESGO TI</a>
        <nav aria-label={t('nav.language')}>
          <a class="lang-switch" href={switchHref} hreflang={otherLocale} lang={otherLocale}>
            {t('nav.switchTo')}
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <small>© {new Date().getFullYear()} SESGO TI. {t('footer.rights')}</small>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .lang-switch {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-underline-offset: 0.25em;
  }
  .lang-switch:hover {
    color: var(--color-text);
  }
  main {
    flex: 1;
  }
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: 1.5rem;
    color: var(--color-text-muted);
  }
</style>
