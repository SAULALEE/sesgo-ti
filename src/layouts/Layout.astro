---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { defaultLocale, locales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const lang: Locale = locales.find((l) => l === Astro.currentLocale) ?? defaultLocale;
const t = useTranslations(lang);
const { title = t('site.title'), description = t('site.description') } = Astro.props;

const pathname = Astro.url.pathname;
const pathInLocale =
  lang === defaultLocale ? pathname : pathname.replace(/^\/en(?=\/|$)/, '') || '/';

// Absolute URLs need `site` (SITE_URL at build time); there is no production domain yet.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = absolute(getRelativeLocaleUrl(lang, pathInLocale));
const alternates = locales.map((l) => ({
  hreflang: l,
  href: absolute(getRelativeLocaleUrl(l, pathInLocale)),
}));
const defaultAlternate = absolute(getRelativeLocaleUrl(defaultLocale, pathInLocale));
const ogLocale = { es: 'es_MX', en: 'en_US' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {
      canonical &&
        alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
    }
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SESGO TI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <Font cssVariable="--font-instrument-serif" />
    <Font cssVariable="--font-inter" />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
